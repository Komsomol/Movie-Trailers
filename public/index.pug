doctype html
include includes/head.pug
	html
		head
			title='Result'
		body
			div.flex-container
				each val in data
					div.channel
						h1=val.channel
						div.videos
							each item in val.data
								li
									h3=item.name
									p=item.date
									div.embed-container
								iframe(type='text/html' src='https://www.youtube.com/embed/'+item.link+'?modestbranding=1&iv_load_policy=3&rel=0&showinfo=0&theme=light&color=white"' allowFullScreen='allowFullScreen' frameborder='0')


include includes/footer.pug
doctype html
include includes/head.pug
	html
		head
			title='Trailers from Channels from 10 days ago'
		body
			div.flex-container
				each val in data
						div.holder
							li
								h3=val.name
								p Posted on 
									=val.date 
								p 
									a(href='https://www.youtube.com/watch?v='+val.link) Link
								div.embed-container
									iframe(type='text/html' src='https://www.youtube.com/embed/'+val.link+'?modestbranding=1&iv_load_policy=3&rel=0&showinfo=0&theme=light&color=white"' allowFullScreen='allowFullScreen' frameborder='0')


include includes/footer.pug
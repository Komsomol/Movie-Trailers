{
  "name": "youtube-channel-watch",
  "version": "2.0.0",
  "description": "Movie trailer aggregator from YouTube channels",
  "main": "app.js",
  "type": "commonjs",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "start": "NODE_ENV=production node app.js",
    "start:improved": "NODE_ENV=production node app.improved.js",
    "dev": "nodemon app.js",
    "dev:improved": "nodemon app.improved.js",
    "dev:fullstack": "concurrently \"npm run dev:improved\" \"npm run client:dev\"",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "client:install": "cd client && npm install",
    "build": "npm run client:build",
    "lint": "eslint '**/*.js'",
    "lint:fix": "eslint '**/*.js' --fix",
    "pretty": "prettier --single-quote --trailing-comma es5 --use-tabs --write '*.js'",
    "audit:fix": "npm audit fix"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^2.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "got": "^11.8.6",
    "json-load": "^1.0.1",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "pm2": "^6.0.13",
    "pug": "^3.0.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
